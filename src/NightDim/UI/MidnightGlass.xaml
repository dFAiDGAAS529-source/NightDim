<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="GlassFontFamily">Segoe UI Variable, Segoe UI</FontFamily>
    <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#10161F"/>
    <SolidColorBrush x:Key="GlassSurfaceBrush" Color="#19222E"/>
    <SolidColorBrush x:Key="GlassRaisedBrush" Color="#253241"/>
    <SolidColorBrush x:Key="GlassTextBrush" Color="#EDF3F7"/>
    <SolidColorBrush x:Key="GlassMutedBrush" Color="#94A5B5"/>
    <SolidColorBrush x:Key="GlassAccentBrush" Color="#83C6DB"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#4594A5B5"/>
    <SolidColorBrush x:Key="GlassAccentSurfaceBrush" Color="#2983C6DB"/>
    <SolidColorBrush x:Key="GlassRailBrush" Color="#668697A8"/>
    <SolidColorBrush x:Key="GlassHoverBrush" Color="#2394A5B5"/>
    <LinearGradientBrush x:Key="GlassTemperatureBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E8AD75" Offset="0"/>
        <GradientStop Color="#DDC1A7" Offset=".37"/>
        <GradientStop Color="#DCE6EA" Offset=".75"/>
        <GradientStop Color="#9ECBF0" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="GlassFocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border Margin="-3" CornerRadius="9" BorderThickness="2"
                            BorderBrush="{DynamicResource GlassAccentBrush}" IsHitTestVisible="False"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="GlassButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource GlassFontFamily}"/>
        <Setter Property="Foreground" Value="{DynamicResource GlassTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GlassRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource GlassFocusVisual}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Hover" Background="{DynamicResource GlassHoverBrush}" CornerRadius="7"
                                    Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GlassMutedBrush}"/>
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.14" FillBehavior="Stop"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value=".78"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value=".45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassIconButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="7"/>
        <Setter Property="MinWidth" Value="32"/>
    </Style>

    <Style x:Key="GlassAccentButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Background" Value="{DynamicResource GlassAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassAccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource GlassBackgroundBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="GlassSectionButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style x:Key="GlassToggle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource GlassMutedBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource GlassFocusVisual}"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel x:Name="Switch" Orientation="Horizontal" Background="Transparent">
                        <ContentPresenter x:Name="Label" Margin="0,0,8,0"
                                          VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        <Border x:Name="Rail" Width="40" Height="22" CornerRadius="11"
                                VerticalAlignment="Center" BorderThickness="1"
                                Background="{DynamicResource GlassRaisedBrush}" BorderBrush="{DynamicResource GlassBorderBrush}">
                            <Ellipse x:Name="Thumb" Fill="{DynamicResource GlassMutedBrush}" Width="12" Height="12"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Rail" Property="Background" Value="{DynamicResource GlassAccentBrush}"/>
                            <Setter TargetName="Rail" Property="BorderBrush" Value="{DynamicResource GlassAccentBrush}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource GlassBackgroundBrush}"/>
                            <Setter TargetName="Thumb" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="18"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True"/>
                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="0" To="18" Duration="0:0:0.15" FillBehavior="Stop">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="18" To="0" Duration="0:0:0.15" FillBehavior="Stop">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Rail" Property="BorderBrush" Value="{DynamicResource GlassAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Switch" Property="Opacity" Value=".5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassPowerToggle" TargetType="CheckBox" BasedOn="{StaticResource GlassToggle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Rail" Width="66" Height="28" CornerRadius="14" BorderThickness="1"
                            Background="{DynamicResource GlassRaisedBrush}" BorderBrush="{DynamicResource GlassBorderBrush}">
                        <Grid>
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="6,0,6,0"
                                     HorizontalAlignment="Left" Fill="{DynamicResource GlassMutedBrush}"/>
                            <TextBlock x:Name="State" Text="{DynamicResource PowerOff}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource GlassMutedBrush}" Margin="22,0,5,0"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Rail" Property="Background" Value="{DynamicResource GlassAccentBrush}"/>
                            <Setter TargetName="Rail" Property="BorderBrush" Value="{DynamicResource GlassAccentBrush}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource GlassBackgroundBrush}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="State" Property="Text" Value="{DynamicResource PowerOn}"/>
                            <Setter TargetName="State" Property="Foreground" Value="{DynamicResource GlassBackgroundBrush}"/>
                            <Setter TargetName="State" Property="Margin" Value="5,0,22,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Rail" Property="BorderBrush" Value="{DynamicResource GlassTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Rail" Property="Opacity" Value=".5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassSegment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource GlassMutedBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource GlassFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Segment" CornerRadius="8" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter RecognizesAccessKey="True"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Segment" Property="Background" Value="{DynamicResource GlassHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource GlassTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Segment" Property="Background" Value="{DynamicResource GlassAccentSurfaceBrush}"/>
                            <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource GlassAccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource GlassTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Segment" Property="Opacity" Value=".5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="GlassInvisibleRepeat" TargetType="RepeatButton">
        <Border Background="Transparent"/>
    </ControlTemplate>

    <Style x:Key="GlassTrackRepeat" TargetType="RepeatButton">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <Style x:Key="GlassScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource GlassTrackRepeat}"
                                          Template="{StaticResource GlassInvisibleRepeat}"/>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb MinHeight="24">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="Grip" Margin="2,1,1,1" CornerRadius="2"
                                                Background="{DynamicResource GlassRailBrush}"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource GlassMutedBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsDragging" Value="True">
                                                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource GlassAccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource GlassTrackRepeat}"
                                          Template="{StaticResource GlassInvisibleRepeat}"/>
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassScrollViewer" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="PanningMode" Value="VerticalOnly"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical"
                                   Style="{StaticResource GlassScrollBar}"
                                   Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassMonitorItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource GlassTextBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}"
                            BorderBrush="Transparent" BorderThickness="1" CornerRadius="7">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource GlassAccentSurfaceBrush}"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource GlassHoverBrush}"/>
                            <Setter TargetName="Item" Property="BorderBrush" Value="{DynamicResource GlassAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassMonitorCombo" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource GlassTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GlassRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="MaxDropDownHeight" Value="232"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource GlassFocusVisual}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource GlassMonitorItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="Container">
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GlassMutedBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GlassAccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="10,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                        <Path Data="M 1,2 L 5,6 L 9,2" Stroke="{DynamicResource GlassMutedBrush}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                              IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Margin="0,4,0,0" Padding="4" CornerRadius="10" BorderThickness="1"
                                    Background="{DynamicResource GlassSurfaceBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Container" Property="Opacity" Value=".5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassSlider" TargetType="Slider">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="{DynamicResource GlassRailBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource GlassAccentBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource GlassFocusVisual}"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="SliderBody" Background="Transparent" SnapsToDevicePixels="True">
                        <Border Height="5" CornerRadius="2.5" Margin="8,0" VerticalAlignment="Center"
                                Background="{TemplateBinding Background}" IsHitTestVisible="False"/>
                        <Track x:Name="PART_Track" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource GlassTrackRepeat}"
                                              Background="{TemplateBinding Foreground}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent">
                                                <Border Height="5" CornerRadius="2.5,0,0,2.5" Margin="8,0,0,0"
                                                        VerticalAlignment="Center" Background="{TemplateBinding Background}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="17" Height="17" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Knob" CornerRadius="9" BorderThickness="2"
                                                    BorderBrush="{DynamicResource GlassSurfaceBrush}"
                                                    Background="{DynamicResource GlassAccentBrush}"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Knob" Property="Background" Value="{DynamicResource GlassTextBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Knob" Property="BorderBrush" Value="{DynamicResource GlassAccentBrush}"/>
                                                    <Setter TargetName="Knob" Property="Background" Value="{DynamicResource GlassTextBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource GlassTrackRepeat}"
                                              Template="{StaticResource GlassInvisibleRepeat}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="SliderBody" Property="Opacity" Value=".5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassTemperatureSlider" TargetType="Slider" BasedOn="{StaticResource GlassSlider}">
        <Setter Property="Background" Value="{DynamicResource GlassTemperatureBrush}"/>
        <Setter Property="Foreground" Value="Transparent"/>
    </Style>
</ResourceDictionary>
