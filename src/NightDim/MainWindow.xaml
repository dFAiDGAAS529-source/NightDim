<Window x:Class="NightDim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:NightDim.UI"
        Title="NightDim" Icon="Assets/NightDim.png" Width="560" MinWidth="410" MinHeight="320" SizeToContent="Height"
        Background="{DynamicResource GlassBackgroundBrush}" Foreground="{DynamicResource GlassTextBrush}"
        FontFamily="{DynamicResource GlassFontFamily}" FontSize="14" Language="ru-RU"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="UI/MidnightGlass.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="QuietText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource GlassMutedBrush}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="NumericText" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            </Style>
            <Style x:Key="LineIcon" TargetType="Path">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="Stroke" Value="{DynamicResource GlassAccentBrush}"/>
                <Setter Property="StrokeThickness" Value="1.5"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Shell" Margin="24,16,24,12" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Source="Assets/NightDim.png" Width="44" Height="44" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                <TextBlock Text="NightDim" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource Tagline}" Style="{StaticResource QuietText}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="EnabledBox" Style="{StaticResource GlassPowerToggle}" VerticalAlignment="Center"
                          Click="EnabledClick" AutomationProperties.Name="{DynamicResource PowerName}"/>
                <Border x:Name="LanguageSelector" Margin="8,0,0,0" CornerRadius="8" Padding="2"
                        Background="{DynamicResource GlassSurfaceBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                    <UniformGrid Columns="2" KeyboardNavigation.TabNavigation="Once">
                        <RadioButton x:Name="EnglishButton" Content="EN" Tag="en" GroupName="Languages"
                                     Style="{StaticResource GlassSegment}" MinHeight="24" Padding="4,2" FontSize="12"
                                     ToolTip="{DynamicResource LanguageEnglish}" Click="LanguageClick"/>
                        <RadioButton x:Name="RussianButton" Content="RU" Tag="ru" GroupName="Languages"
                                     Style="{StaticResource GlassSegment}" MinHeight="24" Padding="4,2" FontSize="12"
                                     ToolTip="{DynamicResource LanguageRussian}" Click="LanguageClick"/>
                    </UniformGrid>
                </Border>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="BodyScroll" Grid.Row="1" Style="{StaticResource GlassScrollViewer}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid>
                <StackPanel x:Name="ControlsPanel">
                    <Border Style="{StaticResource GlassCard}" Padding="12,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Style="{StaticResource LineIcon}" Margin="2,0,10,0"
                                  Data="M1,2 H17 V13 H1 Z M9,13 V17 M5,17 H13"/>
                            <ComboBox x:Name="DisplaysBox" Grid.Column="1" Style="{StaticResource GlassMonitorCombo}"
                                      SelectionChanged="DisplayChanged" AutomationProperties.Name="{DynamicResource Monitor}"
                                      ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <CheckBox x:Name="SyncBox" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                      Content="{DynamicResource MonitorSync}" Style="{StaticResource GlassToggle}" Click="SyncClick"
                                      AutomationProperties.Name="{DynamicResource MonitorSyncName}"
                                      ToolTip="{DynamicResource MonitorSyncTip}"/>
                        </Grid>
                    </Border>

                    <Grid Margin="1,0,1,6">
                        <TextBlock Text="{DynamicResource Profile}" Style="{StaticResource QuietText}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ProfileCaption" Text="{DynamicResource ProfileNeutral}" Style="{StaticResource QuietText}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Background="{DynamicResource GlassSurfaceBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="3" Margin="0,0,0,12">
                        <UniformGrid Columns="4" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
                            <RadioButton x:Name="DayProfile" Tag="day" Content="{DynamicResource ProfileDay}" GroupName="Profiles"
                                         Style="{StaticResource GlassSegment}" Click="ProfileClick"/>
                            <RadioButton x:Name="EveningProfile" Tag="evening" Content="{DynamicResource ProfileEvening}" GroupName="Profiles"
                                         Style="{StaticResource GlassSegment}" Click="ProfileClick"/>
                            <RadioButton x:Name="NightProfile" Tag="night" Content="{DynamicResource ProfileNight}" GroupName="Profiles"
                                         Style="{StaticResource GlassSegment}" Click="ProfileClick"/>
                            <RadioButton x:Name="CustomProfile" Tag="custom" Content="{DynamicResource ProfileCustom}" GroupName="Profiles"
                                         Style="{StaticResource GlassSegment}" Click="ProfileClick"
                                         ToolTip="{DynamicResource ProfileCustomTip}"/>
                        </UniformGrid>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Padding="16,12,16,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" Background="{DynamicResource GlassRaisedBrush}" CornerRadius="10"
                                        VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Path Style="{StaticResource LineIcon}" Width="19" Height="19"
                                          Data="M10,6 A4,4 0 1 1 9.99,6 Z M10,1 V3 M10,17 V19 M1,10 H3 M17,10 H19 M3.6,3.6 L5,5 M15,15 L16.4,16.4 M3.6,16.4 L5,15 M15,5 L16.4,3.6"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{DynamicResource Brightness}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource SoftwareDimming}" Style="{StaticResource QuietText}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock x:Name="BrightnessValue" Grid.Column="2" Text="100%" FontSize="36" LineHeight="40"
                                           Style="{StaticResource NumericText}" Foreground="{DynamicResource GlassAccentBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <ui:PrecisionSlider x:Name="BrightnessSlider" Grid.Row="1" Style="{StaticResource GlassSlider}"
                                    Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="100"
                                    SmallChange="1" LargeChange="5" IsMoveToPointEnabled="True" ValueChanged="SettingChanged"
                                    AutomationProperties.Name="{DynamicResource Brightness}" AutomationProperties.HelpText="{DynamicResource BrightnessHelp}"
                                    ToolTip="{DynamicResource BrightnessTip}"/>
                            <Grid Grid.Row="2">
                                <TextBlock Text="1%" Style="{StaticResource QuietText}"/>
                                <TextBlock Text="100%" Style="{StaticResource QuietText}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Padding="16,12,16,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Temperature}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TemperatureValue" Grid.Column="1" Text="6500 K" FontSize="18"
                                           Style="{StaticResource NumericText}" Margin="8,0,0,0"/>
                            </Grid>
                            <ui:PrecisionSlider x:Name="TemperatureSlider" Grid.Row="1" Style="{StaticResource GlassTemperatureSlider}"
                                    Minimum="2000" Maximum="8000" TickFrequency="100" IsSnapToTickEnabled="True" Value="6500"
                                    SmallChange="100" LargeChange="500" IsMoveToPointEnabled="True" ValueChanged="SettingChanged"
                                    AutomationProperties.Name="{DynamicResource Temperature}"/>
                            <Grid Grid.Row="2">
                                <TextBlock Text="{DynamicResource Warmer}" Style="{StaticResource QuietText}"/>
                                <TextBlock Text="{DynamicResource Cooler}" Style="{StaticResource QuietText}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Button x:Name="FineButton" Style="{StaticResource GlassSectionButton}" Click="FineClick"
                            AutomationProperties.Name="{DynamicResource FineTuning}"
                            ToolTip="{DynamicResource FineTuningTip}">
                        <DockPanel>
                            <Path x:Name="FineChevron" DockPanel.Dock="Right" Style="{StaticResource LineIcon}"
                                  Width="10" Height="6" Margin="8,0,0,0" Data="M1,1 L5,5 L9,1"/>
                            <TextBlock Text="{DynamicResource FineTuning}" FontWeight="SemiBold"/>
                        </DockPanel>
                    </Button>
                    <Border x:Name="FinePanel" Style="{StaticResource GlassCard}" Padding="16,12,16,8"
                            Visibility="Collapsed" Margin="0,8,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{DynamicResource Gamma}"/>
                                <TextBlock x:Name="GammaValue" Style="{StaticResource NumericText}"/>
                            </Grid>
                            <ui:PrecisionSlider x:Name="GammaSlider" Style="{StaticResource GlassSlider}" Minimum="0.5" Maximum="2"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" Value="1" SmallChange="0.05" LargeChange="0.1"
                                    IsMoveToPointEnabled="True" ValueChanged="SettingChanged" AutomationProperties.Name="{DynamicResource Gamma}"/>
                            <Grid>
                                <TextBlock Text="{DynamicResource BlueReduction}"/>
                                <TextBlock x:Name="BlueReductionValue" Style="{StaticResource NumericText}"/>
                            </Grid>
                            <ui:PrecisionSlider x:Name="BlueReductionSlider" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="100"
                                    TickFrequency="1" IsSnapToTickEnabled="True" Value="0" SmallChange="1" LargeChange="5"
                                    IsMoveToPointEnabled="True" ValueChanged="SettingChanged" AutomationProperties.Name="{DynamicResource BlueReduction}"/>
                            <Border Height="1" Background="{DynamicResource GlassBorderBrush}" Margin="0,4,0,12"/>
                            <TextBlock Text="{DynamicResource RgbChannels}" Style="{StaticResource QuietText}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid>
                                <TextBlock Text="{DynamicResource Red}"/>
                                <TextBlock x:Name="RedValue" Style="{StaticResource NumericText}"/>
                            </Grid>
                            <ui:PrecisionSlider x:Name="RedSlider" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="1"
                                    TickFrequency="0.01" Value="1" IsSnapToTickEnabled="True" SmallChange="0.01" LargeChange="0.1"
                                    IsMoveToPointEnabled="True" ValueChanged="SettingChanged" AutomationProperties.Name="{DynamicResource Red}"/>
                            <Grid>
                                <TextBlock Text="{DynamicResource Green}"/>
                                <TextBlock x:Name="GreenValue" Style="{StaticResource NumericText}"/>
                            </Grid>
                            <ui:PrecisionSlider x:Name="GreenSlider" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="1"
                                    TickFrequency="0.01" Value="1" IsSnapToTickEnabled="True" SmallChange="0.01" LargeChange="0.1"
                                    IsMoveToPointEnabled="True" ValueChanged="SettingChanged" AutomationProperties.Name="{DynamicResource Green}"/>
                            <Grid>
                                <TextBlock Text="{DynamicResource Blue}"/>
                                <TextBlock x:Name="BlueValue" Style="{StaticResource NumericText}"/>
                            </Grid>
                            <ui:PrecisionSlider x:Name="BlueSlider" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="1"
                                    TickFrequency="0.01" Value="1" IsSnapToTickEnabled="True" SmallChange="0.01" LargeChange="0.1"
                                    IsMoveToPointEnabled="True" ValueChanged="SettingChanged" AutomationProperties.Name="{DynamicResource Blue}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Settings}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <CheckBox x:Name="StartupBox" Content="{DynamicResource Startup}" Style="{StaticResource GlassToggle}"
                                      Click="StartupClick" HorizontalAlignment="Left" ToolTipService.ShowOnDisabled="True"/>
                            <TextBlock Text="{DynamicResource StartupTip}" Style="{StaticResource QuietText}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Hotkeys}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock x:Name="HotKeyLine" Foreground="{DynamicResource GlassMutedBrush}" TextWrapping="Wrap" LineHeight="22"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SaveCurrent}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ProfilesBox" Style="{StaticResource GlassMonitorCombo}" DisplayMemberPath="Label"
                                          AutomationProperties.Name="{DynamicResource SaveTarget}"/>
                                <Button x:Name="SaveButton" Grid.Column="1" Style="{StaticResource GlassButton}" Margin="8,0,0,0"
                                        Content="{DynamicResource Save}" Click="SaveClick"/>
                            </Grid>
                            <TextBlock x:Name="ProfileSaveHint" Text="{DynamicResource SaveHint}"
                                       Style="{StaticResource QuietText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Diagnostics}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock x:Name="DetailLine" Foreground="{DynamicResource GlassMutedBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource LutReadbackHint}"
                                       Style="{StaticResource QuietText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="ExitButton" Style="{StaticResource GlassButton}" Click="ExitClick"
                            Content="{DynamicResource ExitApp}" HorizontalAlignment="Left" Margin="0,12,0,0"
                            ToolTip="{DynamicResource ExitAppTip}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border x:Name="PreviewPanel" Grid.Row="2" Style="{StaticResource GlassCard}" BorderBrush="{DynamicResource GlassAccentBrush}"
                Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="PreviewText" TextWrapping="Wrap" FontWeight="SemiBold"/>
                <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="CancelButton" Style="{StaticResource GlassButton}" Content="{DynamicResource PreviewCancel}"
                            Click="CancelClick" Margin="0,0,8,0"/>
                    <Button x:Name="KeepButton" Style="{StaticResource GlassAccentButton}" Content="{DynamicResource PreviewKeep}" Click="KeepClick"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <Border Height="1" Background="{DynamicResource GlassBorderBrush}" Margin="0,0,0,8"/>
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button x:Name="ResetButton" Style="{StaticResource GlassButton}" Content="{DynamicResource Reset}" Click="ResetClick"
                            ToolTip="{DynamicResource ResetTip}"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource GlassIconButton}" Click="SettingsClick" Margin="8,0,0,0"
                            ToolTip="{DynamicResource SettingsTip}" AutomationProperties.Name="{DynamicResource Settings}">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/>
                    </Button>
                </StackPanel>
                <DockPanel VerticalAlignment="Center" ToolTipService.ShowOnDisabled="True"
                           ToolTip="{Binding Text, ElementName=DetailLine}">
                    <Ellipse x:Name="StatusDot" DockPanel.Dock="Left" Width="7" Height="7"
                             Fill="{DynamicResource GlassMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusLine" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>
            </DockPanel>
            <TextBlock x:Name="NoticeLine" Style="{StaticResource QuietText}" TextWrapping="Wrap" Margin="0,5,0,0"
                       AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>
